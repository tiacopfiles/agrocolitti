function focusNfeBuscarCompra(mysqli $conexao, string $numeroOs): array
{
    $stmt = $conexao->prepare(
        "SELECT e.*, p.nome AS produto_nome, p.codigo_barras AS produto_codigo_barras, p.codigo_interno AS produto_codigo_interno,
                p.unidade AS produto_unidade, p.ncm AS produto_ncm, p.nfe_ncm AS produto_nfe_ncm, p.nfe_descricao AS produto_nfe_descricao,
                p.nfe_tipo AS produto_nfe_tipo, p.nfe_origem AS produto_nfe_origem, p.preco_custo,
                f.nome AS fornecedor_nome, f.cnpj AS fornecedor_documento, f.telefone AS fornecedor_telefone,
                f.nfe_nome_razao_social, f.nfe_cpf, f.nfe_cnpj, f.nfe_ie, f.nfe_indicador_ie_destinatario,
                f.nfe_telefone, f.nfe_email, f.nfe_endereco, f.nfe_numero, f.nfe_complemento, f.nfe_bairro,
                f.nfe_cidade, f.nfe_estado, f.nfe_cep
         FROM entradas e
         LEFT JOIN produtos p ON p.id = e.produto_id
         LEFT JOIN fornecedores f ON f.id = e.fornecedor_id
         WHERE e.numero_os = ? AND e.tipo = 'entrada_fornecedor'
         ORDER BY e.id ASC"
    );
    $stmt->bind_param('s', $numeroOs);
    $stmt->execute();
    $rows = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
    $stmt->close();
    if (!$rows) {
        throw new RuntimeException('Compra concluida nao encontrada.');
    }
    return $rows;
}

function focusNfeBuscarChaveCompraReferenciada(mysqli $conexao, string $numeroOs, string $ambiente): string
{
    $stmt = $conexao->prepare("
        SELECT chave_nfe
        FROM nfe_documentos
        WHERE numero_os = ?
          AND ambiente = ?
          AND tipo_emissao = 'compra'
          AND status = 'autorizada'
          AND chave_nfe IS NOT NULL
          AND chave_nfe <> ''
        ORDER BY autorizada_em DESC, updated_at DESC, id DESC
        LIMIT 1
    ");
    $stmt->bind_param('ss', $numeroOs, $ambiente);
    $stmt->execute();
    $row = $stmt->get_result()->fetch_assoc();
    $stmt->close();

    $chave = focusNfeSomenteDigitos((string) ($row['chave_nfe'] ?? ''));
    if (strlen($chave) !== 44) {
        throw new RuntimeException('Para emitir devolucao, emita e autorize primeiro a NF-e de compra da mesma OS.');
    }

    return $chave;
}

function focusNfeMontarPayloadCompra(mysqli $conexao, array $config, string $numeroOs, string $tipoEmissao, ?int $localDestino = null): array
{
    $rows = focusNfeBuscarCompra($conexao, $numeroOs);
    $snapshot = pedidoCompraObterSnapshot($conexao, $numeroOs, '', false);
    $primeira = $rows[0];
    $end = focusNfeFornecedorEndereco($primeira);
    $cpf = focusNfeSomenteDigitos($primeira['nfe_cpf'] ?: $primeira['fornecedor_documento'] ?? '');
    $cnpj = focusNfeSomenteDigitos($primeira['nfe_cnpj'] ?: $primeira['fornecedor_documento'] ?? '');
    if (strlen($cpf) !== 11) $cpf = '';
    if (strlen($cnpj) !== 14) $cnpj = '';
    if ($cpf === '' && $cnpj === '') {
        throw new RuntimeException('Fornecedor sem CPF/CNPJ valido para NF-e.');
    }

    $isDevolucao = $tipoEmissao === 'devolucao_compra';
    // Saida de abate sem nota de entrada: sai do estoque (saida), sem nota referenciada e como nota normal (codigo unico).
    $isSaidaAbate = $tipoEmissao === 'saida_abate_sem_entrada';
    // Ambas saem do estoque (documento de saida) e usam a quantidade abatida (descarte).
    $isSaida = $isDevolucao || $isSaidaAbate;

    // Regra: apenas UMA devolucao/saida de abate autorizada por OS.
    if ($isSaida) {
        $stmtDev = $conexao->prepare(
            "SELECT COUNT(*) AS total FROM nfe_documentos
             WHERE numero_os = ? AND ambiente = ?
               AND tipo_emissao IN ('devolucao_compra', 'saida_abate_sem_entrada')
               AND status = 'autorizada'"
        );
        $ambienteCfg = (string) ($config['ambiente'] ?? '');
        $stmtDev->bind_param('ss', $numeroOs, $ambienteCfg);
        $stmtDev->execute();
        $totalDev = (int) ($stmtDev->get_result()->fetch_assoc()['total'] ?? 0);
        $stmtDev->close();
        if ($totalDev > 0) {
            throw new RuntimeException('Ja existe uma devolucao autorizada para esta OS. E permitida apenas uma devolucao por OS.');
        }
    }

    $localDestinoPadrao = $end['uf'] === 'SP' ? 1 : 2;
    $localDestino = $localDestino ?? $localDestinoPadrao;
    if (!in_array($localDestino, [1, 2, 3], true)) {
        throw new RuntimeException('Local de destino invalido para NF-e.');
    }
    if ($localDestino === 3) {
        throw new RuntimeException('Operacao com exterior exige dados de pais e identificacao estrangeira antes da emissao.');
    }
    if ($localDestino === 1 && $end['uf'] !== 'SP') {
        throw new RuntimeException('Local de destino interno requer fornecedor em SP.');
    }
    if ($localDestino === 2 && ($end['uf'] === '' || $end['uf'] === 'SP')) {
        throw new RuntimeException('Local de destino interestadual requer fornecedor fora de SP.');
    }
    $indicadorIeDestinatario = focusNfeIndicadorIe($primeira['nfe_indicador_ie_destinatario'] ?? '', $primeira['nfe_ie'] ?? '');
    $consumidorFinal = $isSaida && $indicadorIeDestinatario === 9 ? 1 : 0;
    $payload = [
        // Devolucao e saida de abate usam natureza de devolucao; entrada normal = compra.
        'natureza_operacao' => $isSaida ? 'Devolucao de compra' : 'Compra de mercadoria',
        'data_emissao' => date('c'),
        // Saida (devolucao ou abate) = documento de saida; entrada = 0.
        'tipo_documento' => $isSaida ? 1 : 0,
        // Devolucao com referencia = finalidade 4; saida de abate sem entrada = nota normal (1).
        'finalidade_emissao' => $isDevolucao ? 4 : 1,
        'local_destino' => $localDestino,
        'consumidor_final' => $consumidorFinal,
        'presenca_comprador' => 2,
        'cnpj_emitente' => focusNfeSomenteDigitos($config['cnpj_emitente'] ?? ''),
        'nome_emitente' => (string) ($config['nome_emitente'] ?? ''),
        'inscricao_estadual_emitente' => focusNfeSomenteDigitos($config['inscricao_estadual_emitente'] ?? ''),
        'regime_tributario_emitente' => $config['regime_tributario_emitente'] !== null ? (int) $config['regime_tributario_emitente'] : null,
        'nome_destinatario' => (string) ($primeira['nfe_nome_razao_social'] ?: $primeira['fornecedor_nome'] ?: 'NAO INFORMADO'),
        'logradouro_destinatario' => $end['logradouro'] ?: 'NAO INFORMADO',
        'numero_destinatario' => $end['numero'] ?: 'S/N',
        'complemento_destinatario' => $end['complemento'],
        'bairro_destinatario' => $end['bairro'] ?: 'NAO INFORMADO',
        'municipio_destinatario' => $end['municipio'],
        'uf_destinatario' => $end['uf'],
        'cep_destinatario' => $end['cep'],
        'telefone_destinatario' => focusNfeSomenteDigitos($primeira['nfe_telefone'] ?: $primeira['fornecedor_telefone'] ?? ''),
        'email_destinatario' => (string) ($primeira['nfe_email'] ?? ''),
        'inscricao_estadual_destinatario' => focusNfeSomenteDigitos($primeira['nfe_ie'] ?? ''),
        'indicador_inscricao_estadual_destinatario' => $indicadorIeDestinatario,
        'modalidade_frete' => (int) $config['modalidade_frete_padrao'],
        'items' => [],
    ];
    if ($cpf !== '') $payload['cpf_destinatario'] = $cpf; else $payload['cnpj_destinatario'] = $cnpj;
    if ($isDevolucao) {
        $payload['notas_referenciadas'] = [[
            'chave_nfe' => focusNfeBuscarChaveCompraReferenciada($conexao, $numeroOs, (string) $config['ambiente']),
        ]];
    }

    $snapshotItensPorProduto = [];
    foreach (($snapshot['itens'] ?? []) as $item) {
        $chaveProduto = focusNfeNormalizarTexto((string) ($item['produto'] ?? ''));
        if ($chaveProduto === '') {
            continue;
        }
        $snapshotItensPorProduto[$chaveProduto][] = $item;
    }
    $snapshotItensUsados = [];

    $numeroItem = 1;
    foreach ($rows as $row) {
        focusNfeValidarVinculoProduto($row, 'compra');
        $chaveProduto = focusNfeNormalizarTexto((string) ($row['produto_nome'] ?? ''));
        $indiceSnapshot = $snapshotItensUsados[$chaveProduto] ?? 0;
        $snap = $snapshotItensPorProduto[$chaveProduto][$indiceSnapshot] ?? [];
        $snapshotItensUsados[$chaveProduto] = $indiceSnapshot + 1;
        $quantidadeBase = (float) ($row['quantidade'] ?? 0);
        // A entrada fiscal espelha o pedido original; o estoque permanece com a quantidade realmente recebida.
        $quantidadePedido = (float) ($snap['quantidade'] ?? 0);
        $quantidade = $isSaida
            ? (float) ($snap['descarte'] ?? 0)
            : ($quantidadePedido > 0 ? $quantidadePedido : $quantidadeBase);
        if ($isSaida && $quantidade <= 0) {
            continue;
        }
        $ncm = focusNfeNcmProduto($row);
        if (strlen($ncm) !== 8) {
            throw new RuntimeException(
                'Produto "' . (string) $row['produto_nome']
                . '" (produto_id ' . (int) $row['produto_id']
                . ') sem NCM valido com 8 digitos.'
            );
        }
        $precoUnitario = (float) ($snap['preco_unitario'] ?? $row['preco_custo'] ?? 0);
        if ($precoUnitario <= 0) {
            $precoUnitario = 0.01;
        }
        $valorTotal = $quantidade * $precoUnitario;
        $unidade = focusNfeUnidade((string) ($row['produto_unidade'] ?? 'KG'));
        $operacao = focusNfeOperacaoManual($tipoEmissao, $end['uf']);
        $codigoProduto = trim((string) ($row['produto_codigo_interno'] ?: $row['produto_codigo_barras'] ?: $row['produto_id']));
        $payload['items'][] = [
            'numero_item' => (string) $numeroItem++,
            'codigo_produto' => $codigoProduto !== '' ? $codigoProduto : (string) $row['produto_id'],
            'descricao' => focusNfeDescricaoCompraSemGramagem((string) ($row['produto_nfe_descricao'] ?: $row['produto_nome'] ?: 'PRODUTO')),
            'cfop' => $operacao['cfop'],
            'unidade_comercial' => $unidade,
            'quantidade_comercial' => number_format($quantidade, 4, '.', ''),
            'valor_unitario_comercial' => number_format($precoUnitario, 4, '.', ''),
            'unidade_tributavel' => $unidade,
            'quantidade_tributavel' => number_format($quantidade, 4, '.', ''),
            'valor_unitario_tributavel' => number_format($precoUnitario, 4, '.', ''),
            'codigo_ncm' => $ncm,
            'valor_bruto' => number_format($valorTotal, 2, '.', ''),
            'icms_situacao_tributaria' => '40',
            'icms_origem' => '0',
            'codigo_beneficio_fiscal' => 'SP010360',
            'pis_situacao_tributaria' => '70',
            'cofins_situacao_tributaria' => '70',
        ];
    }
    if (!$payload['items']) {
        throw new RuntimeException($isSaida ? 'Compra sem quantidade abatida para devolucao/saida.' : 'Compra sem itens para NF-e.');
    }
    $peso = array_sum(array_map(static fn($item) => focusNfeFloat($item['quantidade_comercial'] ?? 0), $payload['items']));
    $payload = focusNfeAplicarVolumes($payload, $peso, $peso, 1, 'VOLUME');
    return [$payload, $rows];
}

function focusNfeOpcoesCompraFromPost(array $post): array
{
    $localDestino = focusNfeLocalDestinoFromPost($post);
    $informacoesAdicionais = focusNfeInformacoesAdicionaisFromPost($post);

    return [
        'local_destino' => $localDestino,
        'informacoes_adicionais_contribuinte' => $informacoesAdicionais,
        'revisao' => [
            'destinatario' => is_array($post['destinatario'] ?? null) ? $post['destinatario'] : [],
            'items' => is_array($post['items'] ?? null) ? $post['items'] : [],
        ],
    ];
}

function focusNfeAplicarRevisaoPayloadCompra(array $payload, array $opcoes): array
{
    if (($opcoes['local_destino'] ?? null) !== null) {
        $payload['local_destino'] = (int) $opcoes['local_destino'];
    }
    $informacoesAdicionais = trim((string) ($opcoes['informacoes_adicionais_contribuinte'] ?? ''));
    if ($informacoesAdicionais !== '') {
        $payload['informacoes_adicionais_contribuinte'] = $informacoesAdicionais;
    }

    $revisao = $opcoes['revisao'] ?? [];
    $dest = is_array($revisao['destinatario'] ?? null) ? $revisao['destinatario'] : [];
    $map = [
        'nome' => 'nome_destinatario',
        'cpf' => 'cpf_destinatario',
        'cnpj' => 'cnpj_destinatario',
        'ie' => 'inscricao_estadual_destinatario',
        'indicador_ie' => 'indicador_inscricao_estadual_destinatario',
        'logradouro' => 'logradouro_destinatario',
        'numero' => 'numero_destinatario',
        'complemento' => 'complemento_destinatario',
        'bairro' => 'bairro_destinatario',
        'municipio' => 'municipio_destinatario',
        'uf' => 'uf_destinatario',
        'cep' => 'cep_destinatario',
        'telefone' => 'telefone_destinatario',
        'email' => 'email_destinatario',
    ];
    foreach ($map as $origem => $campoPayload) {
        if (array_key_exists($origem, $dest)) {
            $valor = trim((string) $dest[$origem]);
            if (in_array($origem, ['cpf', 'cnpj', 'ie', 'cep', 'telefone'], true)) {
                $valor = focusNfeSomenteDigitos($valor);
            }
            if ($origem === 'indicador_ie') {
                $payload[$campoPayload] = (int) $valor;
            } elseif ($valor !== '' || in_array($origem, ['complemento', 'email', 'telefone', 'ie'], true)) {
                $payload[$campoPayload] = $valor;
            }
        }
    }
    $cpfDestinatario = focusNfeSomenteDigitos((string) ($payload['cpf_destinatario'] ?? ''));
    $cnpjDestinatario = focusNfeSomenteDigitos((string) ($payload['cnpj_destinatario'] ?? ''));
    $cpfValido = strlen($cpfDestinatario) === 11;
    $cnpjValido = strlen($cnpjDestinatario) === 14;
    unset($payload['cpf_destinatario'], $payload['cnpj_destinatario']);
    if ($cnpjValido) {
        $payload['cnpj_destinatario'] = $cnpjDestinatario;
    } elseif ($cpfValido) {
        $payload['cpf_destinatario'] = $cpfDestinatario;
    }
    $localDestino = (int) ($payload['local_destino'] ?? 0);
    $ufDestino = strtoupper(trim((string) ($payload['uf_destinatario'] ?? '')));
    if ($localDestino === 3) {
        throw new RuntimeException('Operacao com exterior exige dados de pais e identificacao estrangeira antes da emissao.');
    }
    if ($localDestino === 1 && $ufDestino !== 'SP') {
        throw new RuntimeException('Local de destino interno requer fornecedor em SP.');
    }
    if ($localDestino === 2 && ($ufDestino === '' || $ufDestino === 'SP')) {
        throw new RuntimeException('Local de destino interestadual requer fornecedor fora de SP.');
    }

    $items = is_array($revisao['items'] ?? null) ? $revisao['items'] : [];
    $idxExcluir = [];
    foreach ($payload['items'] as $idx => &$item) {
        $posted = $items[$idx] ?? null;
        if (!is_array($posted)) {
            continue;
        }
        if (!empty($posted['excluir']) && (string) $posted['excluir'] === '1') {
            $idxExcluir[] = $idx;
            continue;
        }
        foreach (['codigo_produto', 'descricao', 'cfop', 'codigo_ncm', 'unidade_comercial', 'unidade_tributavel', 'icms_situacao_tributaria', 'icms_origem', 'pis_situacao_tributaria', 'cofins_situacao_tributaria', 'codigo_beneficio_fiscal'] as $campo) {
            if (array_key_exists($campo, $posted)) {
                $valor = trim((string) $posted[$campo]);
                if ($campo === 'codigo_ncm') {
                    $valor = focusNfeSomenteDigitos($valor);
                }
                if ($campo === 'codigo_beneficio_fiscal') {
                    $codigoBeneficio = focusNfeCodigoBeneficioFiscalValido($valor);
                    if ($codigoBeneficio === null) {
                        unset($item[$campo]);
                    } else {
                        $item[$campo] = $codigoBeneficio;
                    }
                } elseif ($valor !== '') {
                    $item[$campo] = $valor;
                }
            }
        }
        foreach (['quantidade_comercial', 'valor_unitario_comercial', 'quantidade_tributavel', 'valor_unitario_tributavel', 'valor_bruto'] as $campo) {
            if (array_key_exists($campo, $posted)) {
                $item[$campo] = number_format(max(0.0, focusNfeFloat($posted[$campo])), $campo === 'valor_bruto' ? 2 : 4, '.', '');
            }
        }
        $qtdComercial = max(0.0, focusNfeFloat($item['quantidade_comercial'] ?? 0));
        $vuComercial = max(0.0, focusNfeFloat($item['valor_unitario_comercial'] ?? 0));
        $item['quantidade_comercial'] = number_format($qtdComercial, 4, '.', '');
        $item['valor_unitario_comercial'] = number_format($vuComercial, 4, '.', '');
        $item['quantidade_tributavel'] = $item['quantidade_comercial'];
        $item['valor_unitario_tributavel'] = $item['valor_unitario_comercial'];
        $item['valor_bruto'] = number_format(round($qtdComercial * $vuComercial, 2), 2, '.', '');
    }
    unset($item);

    if ($idxExcluir) {
        foreach ($idxExcluir as $i) {
            unset($payload['items'][$i]);
        }
        $payload['items'] = array_values($payload['items']);
        $numeroItem = 1;
        foreach ($payload['items'] as &$itemRenum) {
            $itemRenum['numero_item'] = (string) $numeroItem++;
        }
        unset($itemRenum);
    }
    if (empty($payload['items'])) {
        throw new RuntimeException('Selecione ao menos um produto para emitir a NF-e.');
    }

    $peso = 0.0;
    foreach ($payload['items'] as $itPeso) {
        $peso += focusNfeFloat($itPeso['quantidade_comercial'] ?? 0);
    }
    $payload = focusNfeAplicarVolumes($payload, $peso, $peso, 1, 'VOLUME');

    return $payload;
}

function focusNfeEmitirCompraRevisada(mysqli $conexao, string $numeroOs, string $tipoEmissao, array $opcoes, string $ambiente = 'producao'): array
{
    if (!in_array($tipoEmissao, ['compra', 'devolucao_compra', 'saida_abate_sem_entrada'], true)) {
        $tipoEmissao = 'compra';
    }
    $config = focusNfeLoadConfig($conexao, $ambiente);
    $localDestino = isset($opcoes['local_destino']) && $opcoes['local_destino'] !== null ? (int) $opcoes['local_destino'] : null;
    [$payload, $rows] = focusNfeMontarPayloadCompra($conexao, $config, $numeroOs, $tipoEmissao, $localDestino);
    $payload = focusNfeAplicarRevisaoPayloadCompra($payload, $opcoes);

    $prefixo = $tipoEmissao === 'devolucao_compra'
        ? 'DEV-COMPRA-OS-'
        : ($tipoEmissao === 'saida_abate_sem_entrada' ? 'SAIDA-ABATE-OS-' : 'COMPRA-OS-');
    $ref = $prefixo . preg_replace('/[^A-Za-z0-9_-]/', '-', trim($numeroOs));
    $primeira = $rows[0];
    $documentoId = focusNfeDocumentoOperacao($conexao, $ref, [
        'tipo_emissao' => $tipoEmissao,
        'origem_tipo' => 'compra',
        'origem_id' => (int) ($primeira['id'] ?? 0),
        'numero_os' => $numeroOs,
        'fornecedor_id' => (int) ($primeira['fornecedor_id'] ?? 0),
    ], $config, $payload, $opcoes);

    return focusNfeEnviarOperacao($conexao, $config, $documentoId, $ref, $payload);
}

function focusNfeEmitirCompraOperacao(mysqli $conexao, string $numeroOs, string $tipoEmissao, string $ambiente = 'producao', ?int $localDestino = null, string $informacoesAdicionais = ''): array
{
    $config = focusNfeLoadConfig($conexao, $ambiente);
    [$payload, $rows] = focusNfeMontarPayloadCompra($conexao, $config, $numeroOs, $tipoEmissao, $localDestino);
    $informacoesAdicionais = trim($informacoesAdicionais);
    if ($informacoesAdicionais !== '') {
        $payload['informacoes_adicionais_contribuinte'] = $informacoesAdicionais;
    }
    $prefixo = $tipoEmissao === 'devolucao_compra'
        ? 'DEV-COMPRA-OS-'
        : ($tipoEmissao === 'saida_abate_sem_entrada' ? 'SAIDA-ABATE-OS-' : 'COMPRA-OS-');
    $ref = $prefixo . preg_replace('/[^A-Za-z0-9_-]/', '-', trim($numeroOs));
    $primeira = $rows[0];
    $documentoId = focusNfeDocumentoOperacao($conexao, $ref, [
        'tipo_emissao' => $tipoEmissao,
        'origem_tipo' => 'compra',
        'origem_id' => (int) ($primeira['id'] ?? 0),
        'numero_os' => $numeroOs,
        'fornecedor_id' => (int) ($primeira['fornecedor_id'] ?? 0),
    ], $config, $payload, ['local_destino' => $localDestino, 'informacoes_adicionais_contribuinte' => $informacoesAdicionais, 'revisao' => []]);

    return focusNfeEnviarOperacao($conexao, $config, $documentoId, $ref, $payload);
}
