}

function nfeParsearEndereco(string $txt): array {
    $cep = $uf = $cidade = $bairro = $xLgr = $nro = '';
    if (preg_match('/\b(\d{5})[.\-]?(\d{3})\b/', $txt, $m)) {
        $cep = $m[1] . $m[2];
    }
    if (preg_match('/[-,]\s*([A-Z]{2})\s*[,\s]*(CEP|$)/i', $txt, $m)) {
        $uf = strtoupper($m[1]);
    }
    if (empty($uf) && preg_match('/\b([A-Z]{2})\b/', $txt, $m)) {
        $uf = $m[1];
    }
    if ($uf && preg_match('/([^,]+)-' . preg_quote($uf, '/') . '/i', $txt, $m)) {
        $cidade = trim($m[1]);
        // remove sub-bairro type labels
        $cidade = preg_replace('/\b(S[aã]o|de|da|do)\b\s+/iu', '$1 ', $cidade);
        $cidade = trim($cidade);
    }
    $partes = array_map('trim', explode(',', $txt));
    if (count($partes) >= 1) $xLgr = $partes[0];
    if (count($partes) >= 2 && preg_match('/^\d/', $partes[1])) {
        $nro   = $partes[1];
        $bairro = $partes[2] ?? '';
    } elseif (count($partes) >= 2) {
        $bairro = $partes[1];
        $nro    = 'SN';
    }
    return [
        'xLgr'   => mb_substr(trim($xLgr), 0, 60),
        'nro'    => mb_substr(trim($nro) ?: 'SN', 0, 10),
        'xBairro'=> mb_substr(trim($bairro), 0, 60),
        'xMun'   => mb_substr(trim($cidade), 0, 60),
        'UF'     => $uf ?: 'SP',
        'CEP'    => $cep ?: '00000000',
    ];
}

