function nfeNormNome(string $s): string {
    $s = mb_strtolower(trim($s), 'UTF-8');
    $de = ['à','á','â','ã','ä','å','ç','è','é','ê','ë','ì','í','î','ï','ñ','ò','ó','ô','õ','ö','ù','ú','û','ü','ý','ÿ'];
    $pa = ['a','a','a','a','a','a','c','e','e','e','e','i','i','i','i','n','o','o','o','o','o','u','u','u','u','y','y'];
    return preg_replace('/[^a-z0-9 ]/', '', str_replace($de, $pa, $s));
}

function nfeObterNcm(string $nome, array $mapa): string {
    $norm = nfeNormNome($nome);
    uksort($mapa, fn($a, $b) => strlen($b) - strlen($a));
    foreach ($mapa as $kw => $ncm) {
        if (str_contains($norm, $kw)) return $ncm;
    }
    return '07099990';
}

function nfeLimparDoc(string $doc): string {
