function nfeCdv(string $chave43): string {
    $peso = 2; $soma = 0;
    for ($i = strlen($chave43) - 1; $i >= 0; $i--) {
        $soma += (int)$chave43[$i] * $peso;
        $peso = $peso >= 9 ? 2 : $peso + 1;
    }
    $r = $soma % 11;
    return (string)($r < 2 ? 0 : 11 - $r);
}

function nfeGerarChave(string $cnpj, string $mod, string $serie, string $nNF, string $tpEmis, string $aamm): string {
    $cUF     = '35';
    $cNF     = str_pad((string)random_int(10000000, 99999999), 8, '0', STR_PAD_LEFT);
    $serieP  = str_pad($serie, 3, '0', STR_PAD_LEFT);
    $nNFP    = str_pad($nNF, 9, '0', STR_PAD_LEFT);
    $chave43 = $cUF . $aamm . $cnpj . $mod . $serieP . $nNFP . $tpEmis . $cNF;
    return $chave43 . nfeCdv($chave43);
}

